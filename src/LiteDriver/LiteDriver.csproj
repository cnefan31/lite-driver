<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LiteDriver</AssemblyName>
    <RootNamespace>LiteDriver</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NativeAOT / trimming：全库不使用反射、动态加载或运行时代码生成 -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LiteDriver</PackageId>
    <Version>1.0.0</Version>
    <Description>面向工业 SOCKET 设备的轻量 TCP 连接管理库：断线重连、运行时增改删设备与监听端点、可插拔帧编解码、显式命令结果语义，零 NuGet 依赖核心并支持 .NET 通用主机与 NativeAOT。</Description>
    <PackageTags>tcp;socket;industrial;plc;gateway;aot;nativeaot;reconnect;lightweight;iot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
    <None Include="../../docs/API.md" Pack="true" PackagePath="docs/" Condition="Exists('../../docs/API.md')" />
    <None Include="../../docs/CONFIGURATION.md" Pack="true" PackagePath="docs/" Condition="Exists('../../docs/CONFIGURATION.md')" />
  </ItemGroup>


  <ItemGroup>
    <!-- 让测试工程可以验证内部不变量（例如配置冻结校验） -->
    <InternalsVisibleTo Include="LiteDriver.Tests" />
  </ItemGroup>

</Project>
