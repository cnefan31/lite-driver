<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NanoServer 1.0.0 只提供 net10.0 资产，故本包仅面向 net10.0。
         它引用的 LiteDriver 与 LiteDriver.Hosting 仍是双 TFM，此处自动选用 net10.0 资产。 -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LiteDriver.Orchestration</AssemblyName>
    <RootNamespace>LiteDriver.Orchestration</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LiteDriver.Orchestration</PackageId>
    <Version>0.2.0</Version>
    <Description>LiteDriver 的可视化功能编排库：基于 NanoServer 提供拖拽式编排页面，在线增删改客户端/服务端/协议节点，保存后热应用，无需重启后端服务。</Description>
    <PackageTags>tcp;socket;industrial;orchestration;visual;drag-drop;nano-server;aot;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LiteDriver/LiteDriver.csproj" />
    <ProjectReference Include="../LiteDriver.Hosting/LiteDriver.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 页面由编排库承载，故用 NanoServer -->
    <PackageReference Include="NanoServer" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/index.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- 包内 README 用编排库自己的说明，比根 README 更贴合本包内容 -->
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiteDriver.Tests" />
  </ItemGroup>

</Project>
