<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LiteDriver.AotSmoke</AssemblyName>
    <RootNamespace>LiteDriver.AotSmoke</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 真实 NativeAOT 发布，用于验证核心在裁剪后的原生二进制里可用 -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>

  </PropertyGroup>

  <PropertyGroup>
    <!-- 固定到已修复 GHSA-p3jp-9v83-76w9 的 ILCompiler 版本，规避 NU1903 -->
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.33</RuntimeFrameworkVersion>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 覆盖核心全部 API，避免被裁剪掉后"发布成功但运行时缺失" -->
    <TrimmerRootAssembly Include="LiteDriver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LiteDriver/LiteDriver.csproj" />
  </ItemGroup>

</Project>
