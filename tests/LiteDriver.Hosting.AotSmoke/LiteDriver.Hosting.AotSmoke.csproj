<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>LiteDriver.Hosting.AotSmoke</AssemblyName>
    <RootNamespace>LiteDriver.Hosting.AotSmoke</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 与核心 smoke 同样按真 NativeAOT 发布，验证通用主机集成在裁剪后可运行 -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 固定到已修复 GHSA-p3jp-9v83-76w9 的 ILCompiler 版本，规避 NU1903 -->
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.33</RuntimeFrameworkVersion>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="LiteDriver" />
    <TrimmerRootAssembly Include="LiteDriver.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LiteDriver/LiteDriver.csproj" />
    <ProjectReference Include="../../src/LiteDriver.Hosting/LiteDriver.Hosting.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
